{
  "name": "purpledot/validation-bundle",
  "type": "symfony-bundle",
  "description": ".",
  "keywords": ["symfony","validation", "validator", "id card", "polish id card", "pesel", "nip", "polish tax number", "polish mobile phone", "mobile phone"],
  "homepage": "http://purpledot.pl",
  "license": "MIT",
  "authors": [
    {
      "name": "PurpleDot Robert Pajer",
      "email": "kontakt@purpledot.pl"
    }
  ],
  "require": {
    "php": ">=8.0",
    "symfony/framework-bundle": "~6.0|~7.0|~8.0",
    "symfony/dependency-injection": "~6.0|~7.0|~8.0",
    "symfony/validator": "~6.0|~7.0|~8.0",
    "ext-mbstring": "*"
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "autoload": {
    "psr-4": { "PurpleDot\\ValidationBundle\\": "src/" }
  },
  "extra": {
    "branch-alias": {
      "dev-master": "2.0-dev"
    }
  },
  "config": {
    "allow-plugins": {
      "infection/extension-installer": true
    }
  }
}
